# Copier en .env pour le développement local.
#
# Attention : Vite inline les variables VITE_* au moment du build. En production
# cette valeur est fournie en build-arg par la CI (variables GitHub DEV_API_URL /
# PROD_API_URL) et figée dans le bundle — la changer dans Dokploy n'a aucun effet.
VITE_API_URL=http://localhost:3001
